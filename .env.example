# Docker Compose. Run npm run setup:env to generate local credentials.
POSTGRES_DB=bagua_webgis
POSTGRES_USER=bagua
POSTGRES_PASSWORD=
HTTP_PORT=8080
# Configurable MapLibre provider; OpenFreeMap is the initial default.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Independent map modules (true/false). BAGUA MASTER = Overture Maps urban map.
MUNICIPAL_MAP_ENABLED=true
BAGUA_MASTER_ENABLED=true

