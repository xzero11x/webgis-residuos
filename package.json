{
  "name": "bagua-webgis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "setup:env": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d --build --wait",
    "infra:down": "docker compose down",
    "db:dev": "docker compose -f compose.yaml -f infrastructure/compose.dev.yaml up -d --wait database",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "seed:demo": "node scripts/database.mjs seed",
    "seed:demo:clear": "node scripts/database.mjs clear-demo",
    "import:municipal": "node scripts/database.mjs import-municipal",
    "gis:inspect": ".venv-gis/Scripts/python scripts/gis/inspect_sources.py",
    "gis:convert": ".venv-gis/Scripts/python scripts/gis/convert_cad.py",
    "gis:extract": ".venv-gis/Scripts/python scripts/gis/extract_cad.py",
    "gis:register": ".venv-gis/Scripts/python scripts/gis/register_pdf.py && .venv-gis/Scripts/python scripts/gis/refine_pdf.py",
    "gis:build": ".venv-gis/Scripts/python scripts/gis/build_dataset.py",
    "gis:deep": ".venv-gis/Scripts/python scripts/gis/deep_audit.py && .venv-gis/Scripts/python scripts/gis/deep_derive.py",
    "gis:deep:package": ".venv-gis/Scripts/python scripts/gis/deep_package.py",
    "dev:all": "node scripts/dev.mjs",
    "gis:cartography": ".venv-gis/Scripts/python scripts/gis/cartography.py",
    "gis:align:cofopri": ".venv-gis/Scripts/python scripts/gis/align_cofopri.py",
    "gis:reconcile": ".venv-gis/Scripts/python scripts/gis/reconcile_cad.py",
    "gis:territory": ".venv-gis/Scripts/python scripts/gis/unify_territory.py",
    "gis:forensic": ".venv-gis/Scripts/python scripts/gis/forensic_check.py --baseline && .venv-gis/Scripts/python scripts/gis/forensic_native.py && .venv-gis/Scripts/python scripts/gis/forensic_dxf.py && .venv-gis/Scripts/python scripts/gis/forensic_versions.py && .venv-gis/Scripts/python scripts/gis/forensic_lost.py && .venv-gis/Scripts/python scripts/gis/forensic_matrix.py && .venv-gis/Scripts/python scripts/gis/forensic_extras.py && .venv-gis/Scripts/python scripts/gis/forensic_pending.py && .venv-gis/Scripts/python scripts/gis/forensic_pending_geo.py && .venv-gis/Scripts/python scripts/gis/forensic_report.py && .venv-gis/Scripts/python scripts/gis/forensic_check.py --verify",
    "gis:forensic:test": ".venv-gis/Scripts/python -m unittest discover -s scripts/gis/tests",
    "import:reconciliation": "docker compose exec -T backend node backend/dist/db/import-reconciliation.js",
    "import:cartography": "docker compose exec -T backend node backend/dist/db/import-cartography.js",
    "import:segunda-pasada": "docker compose exec -T backend node backend/dist/db/import-second-pass.js",
    "import:territory": "docker compose exec -T backend node backend/dist/db/import-territory.js",
    "bagua-master:descargar": "node scripts/bagua-master/run.mjs descargar",
    "bagua-master:verificar": "node scripts/bagua-master/run.mjs verificar",
    "bagua-master:paquete": "node scripts/bagua-master/run.mjs paquete",
    "bagua-master:rotulos": "node scripts/bagua-master/run.mjs rotulos",
    "bagua-master:zonas-nombres": "node scripts/bagua-master/run.mjs zonas-nombres",
    "bagua-master:glifos": "node scripts/bagua-master/run.mjs glifos",
    "bagua-master:imagen-teselas": "node scripts/bagua-master/run.mjs imagen-teselas",
    "bagua-master:teselas": "node scripts/bagua-master/run.mjs teselas",
    "bagua-master:importar": "node scripts/bagua-master/run.mjs importar",
    "bagua-master:nombres-dwg": "node scripts/bagua-master/run.mjs nombres-dwg",
    "bagua-master:importar-nombres": "node scripts/bagua-master/run.mjs importar-nombres",
    "bagua-master:exportar-rutas": "node scripts/bagua-master/run.mjs exportar-rutas",
    "bagua-master:importar-rutas": "node scripts/bagua-master/run.mjs importar-rutas",
    "bagua-master:proteccion-escribir": "node scripts/bagua-master/run.mjs proteccion-escribir",
    "bagua-master:proteccion-verificar": "node scripts/bagua-master/run.mjs proteccion-verificar",
    "bagua-master:independencia": "node scripts/bagua-master/independencia.mjs",
    "bagua-master:medir-rotulos": "node scripts/bagua-master/medir_rotulos.mjs",
    "bagua-master:capturar-nombres": "node scripts/bagua-master/capturar_nombres.mjs",
    "bagua-master:leer-teselas": "node scripts/bagua-master/leer_teselas.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
